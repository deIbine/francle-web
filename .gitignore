# Dépendances installées par npm (recréées par « npm ci »)
node_modules/
# Site construit par « npm run build »
dist/
# Journaux et fichiers de l'éditeur
*.log
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
# Réglages locaux de Claude Code (serveur de prévisualisation)
.claude/
# Le serveur (serveur/) : la base locale de « wrangler dev » et le Worker construit
.wrangler/

# Les secrets du serveur en local (wrangler dev), comme la clé de modération : jamais dans le dépôt
.dev.vars
